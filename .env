# Variable de entorno de Bita
# Controla si se cargan los datos de demostración o la app arranca vacía
EXPO_PUBLIC_DEMO_MODE=false

# URL base del backend Laravel (API real).
# En el simulador de iOS puedes usar http://localhost:8000/api.
# En un dispositivo físico o emulador Android necesitas la IP de tu Mac en la red local
# (corre `php artisan serve --host=0.0.0.0` en el backend y ajusta esta URL si cambia tu IP).
EXPO_PUBLIC_API_URL=http://192.168.0.27:8000/api

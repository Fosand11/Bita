# Copia este archivo a .env y ajusta los valores.

# Si es 'true' o '1' se cargan los datos de demostración; si no, la app arranca vacía
EXPO_PUBLIC_DEMO_MODE=false

# URL base del backend Laravel (API real).
# Simulador iOS: http://localhost:8000/api
# Dispositivo físico / emulador Android: IP de tu Mac en la red local, p. ej. http://192.168.x.x:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
